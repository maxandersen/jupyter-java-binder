# what java version to use for jbang and the kernels
# you can make them different if you want
# but we are defaulting to one version to speed up the 
# build and the launch time.
JAVA_VERSION=25

# only required to allow pulling content from an arbitrary repository
# remove if you do not want this feature
jupyter server extension enable --py nbgitpuller --sys-prefix

# Install JBang
export JBANG_DEFAULT_JAVA_VERSION=$JAVA_VERSION
curl -Ls https://sh.jbang.dev | bash -s - app setup

# Setup up path explicitly for accessing jbang directly
export PATH=$HOME/.jbang/bin:$PATH

# Trust jupyter-java so no prompting needed for kernels
jbang trust add https://github.com/jupyter-java/

## install kernels
jbang install-kernel@jupyter-java --java $JAVA_VERSION jbang
jbang install-kernel@jupyter-java --java $JAVA_VERSION jjava
jbang install-kernel@jupyter-java --java $JAVA_VERSION rapaio
jbang install-kernel@jupyter-java --java $JAVA_VERSION kotlin
jbang install-kernel@jupyter-java --java $JAVA_VERSION ijava
## end install kernels

# Install the jupyter-jbang-runner extension
cd jupyter-jbang-runner
# Build the extension
npm install --no-prepare
npm run build:prod
# Install as Python package
pip install -e .
# Link the extension for development
jupyter labextension develop . --overwrite
cd ..

# Build JupyterLab to include the new extension
jupyter lab build --minimize=False

# Clean up to reduce Docker image size
echo "Cleaning up build artifacts to reduce image size..."

# Remove npm cache and node_modules
cd jupyter-jbang-runner
rm -rf node_modules
rm -rf lib
rm -rf .npm
npm cache clean --force
cd ..

# Remove other build artifacts
rm -rf ~/.npm
rm -rf ~/.cache
rm -rf /tmp/*

echo "Cleanup complete!"
